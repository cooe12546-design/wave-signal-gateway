PORT=3000
SIGNAL_EVENT_API_KEY=change_me
DATABASE_PATH=./data/wave-signal-gateway.db

# LINE Messaging API (L3) -- server-side secret only, never committed with
# a real value. Never returned in any API response, never logged, never
# stored in SQLite.
LINE_CHANNEL_ACCESS_TOKEN=

# LINE webhook signature verification (L3A) -- DIFFERENT secret from
# LINE_CHANNEL_ACCESS_TOKEN above; do not confuse the two. Used only to
# verify inbound POST /line/webhook requests via HMAC-SHA256, never sent
# to LINE, never logged.
LINE_CHANNEL_SECRET=

# L5: persistent delivery ledger tuning (all optional; sensible defaults
# apply if unset). See README's "Persistent Delivery State" section for
# the reasoning behind each default -- these are INTERIM values, not
# Owner-frozen policy.
DELIVERY_STALE_SENDING_THRESHOLD_MS=300000
DELIVERY_MAX_PERSISTED_ATTEMPTS=8
DELIVERY_RETRY_BASE_DELAY_MS=30000
DELIVERY_SWEEP_INTERVAL_MS=15000

# L3-only test recipient (userId/groupId/roomId). Real account<->recipient
# mapping is L4's responsibility, not this.
LINE_TEST_RECIPIENT_ID=

# LINE Sender retry/timeout policy (brief §10/§21) -- these defaults match
# what the code falls back to if unset; only override if you need different
# behavior.
LINE_MAX_ATTEMPTS=3
LINE_RETRY_DELAY_MS=1000
LINE_TIMEOUT_MS=8000
